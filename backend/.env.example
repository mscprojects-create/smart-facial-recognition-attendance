# Copy to .env and fill in your Supabase project values
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=YOUR-service-role-key   # service_role key (server-side only!)
JWT_SECRET=change-this-to-a-long-random-string
FACE_MATCH_TOLERANCE=0.50                     # lower = stricter (dlib default 0.6)
FLASK_PORT=5000
